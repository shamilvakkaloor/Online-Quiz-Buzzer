# With these unset, the app runs a local PostgreSQL practice workspace.
# Explicitly set false when deploying. Production fails closed if credentials are missing.
DEMO_MODE=false
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=
# Optional: configure the matching Turnstile secret in Supabase Auth CAPTCHA settings.
NEXT_PUBLIC_TURNSTILE_SITE_KEY=
# Optional for local production-build preview only: DEMO_MODE=true
